{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mv tsconfig.json tsconfig.json.bak && cat > tsconfig.json << 'TSCEOF'\n{ \"files\": [], \"include\": [\"src\"], \"exclude\": [\"api\", \"node_modules\"] }\nTSCEOF\nnpx vite build\nEXIT=$?\nmv tsconfig.json.bak tsconfig.json\nexit $EXIT",
  "installCommand": "bun install --ignore-scripts",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
