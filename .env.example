# =============================================================================
# ohmOS — Environment Variables
# =============================================================================
# Copy to .env and fill in your values.
# All vars are optional unless marked as REQUIRED for the feature they enable.

# ── Deployment ──────────────────────────────────────────────────────────────
APP_PUBLIC_ORIGIN=             # Public URL of this instance, e.g. https://ohmxo.com. Required in production.
PUBLIC_APP_ORIGIN=             # Alias for APP_PUBLIC_ORIGIN
NODE_ENV=                      # "production" or "development" (default)
API_RUNTIME_ENV=               # Override runtime env: "production" | "development"
API_ENV=                        # Alias for API_RUNTIME_ENV
API_PORT=                      # Port for the standalone API server (default 3000)
API_HOST=                      # Host for the standalone API server (default 0.0.0.0)
PORT=                          # Fallback port (used if API_PORT not set)
TRUSTED_PROXY_COUNT=           # Number of trusted reverse proxies for correct client IP detection
CRON_SECRET=                   # Shared secret for cron endpoint authentication
RYOS_DEBUG=                    # Enable debug logs: "1" | "true"
API_DEBUG_LOGS=                # Enable API debug logs: "1" | "true"
API_URL=                       # Base URL for API calls (development helper)

# ── Allowed Origins / Hosts ─────────────────────────────────────────────────
API_ALLOWED_ORIGINS=           # Comma-separated CORS origins, e.g. "https://app.ohmxo.com,*.ohmxo.com"
APP_ALLOWED_HOSTS=             # Comma-separated allowed Host header values, e.g. "ohmxo.com,*.vercel.app"
API_ALLOWED_HOSTS=             # Alias for APP_ALLOWED_HOSTS
AUTH_COOKIE_SECURE=            # Set "1" to force Secure flag on auth cookies

# ── Redis (required for auth, sync, realtime) ────────────────────────────────
REDIS_URL=                     # Redis connection string, e.g. redis://localhost:6379
REDIS_KV_REST_API_URL=         # Upstash-style Redis REST API URL (alternative to REDIS_URL)
REDIS_KV_REST_API_TOKEN=       # Upstash-style Redis REST API token
REDIS_PROVIDER=                # Force provider: "upstash" | "ioredis". Auto-detected if unset.

# ── Realtime (Pusher OR local WebSocket) ────────────────────────────────────
REALTIME_PROVIDER=             # "pusher" (default) or "local" (self-hosted WebSocket)
REALTIME_WS_PATH=              # WebSocket path for local realtime (default "/ws")
REALTIME_DEBUG=                # Enable realtime debug logging: "1" | "true"
PUSHER_APP_ID=                 # Pusher app ID
PUSHER_KEY=                    # Pusher key
PUSHER_PUBLIC_KEY=             # Pusher public key (overrides PUSHER_KEY for client config)
PUSHER_SECRET=                 # Pusher secret
PUSHER_CLUSTER=                # Pusher cluster (default "us3")
PUSHER_FORCE_TLS=              # Force TLS for Pusher (default "true")

# ── Authentication & Email ──────────────────────────────────────────────────
RESEND_API_KEY=                # Resend API key for sending recovery emails. Required for email recovery.
RECOVERY_EMAIL_FROM=           # From address for recovery emails, e.g. "ohmOS <noreply@ohmxo.com>"

# ── AI / LLM Providers ─────────────────────────────────────────────────────
OPENAI_API_KEY=                # OpenAI API key (used by speech TTS, audio transcription, etc.)
GOOGLE_GENERATIVE_AI_API_KEY=  # Google Gemini API key (used by applet-ai, parse-title, doc generation)
ELEVENLABS_API_KEY=            # ElevenLabs API key (used by speech TTS when model is "elevenlabs")

# ── Apple Services ──────────────────────────────────────────────────────────
MAPKIT_PRIVATE_KEY=            # Apple MapKit JS private key (PKCS#8). Required for Maps app.
MAPKIT_TEAM_ID=                # Apple Developer team ID
MAPKIT_KEY_ID=                 # Apple MapKit key ID
MAPKIT_ORIGIN=                 # Allowed origin for MapKit JS tokens (defaults to APP_PUBLIC_ORIGIN)
MUSICKIT_PRIVATE_KEY=          # Apple MusicKit private key (falls back to MAPKIT_PRIVATE_KEY)
MUSICKIT_TEAM_ID=              # Apple MusicKit team ID (falls back to MAPKIT_TEAM_ID)
MUSICKIT_KEY_ID=               # Apple MusicKit key ID (falls back to MAPKIT_KEY_ID)
MUSICKIT_ORIGIN=               # Allowed origin for MusicKit JS tokens

# ── File Storage (S3-compatible) ────────────────────────────────────────────
STORAGE_PROVIDER=              # "s3" to enable S3 storage. Omit for in-memory/no-op storage.
S3_BUCKET=                     # S3 bucket name
S3_REGION=                     # S3 region
S3_ENDPOINT=                   # S3 endpoint URL
S3_PUBLIC_ENDPOINT=            # Public-facing S3 endpoint (falls back to S3_ENDPOINT)
S3_ACCESS_KEY_ID=              # S3 access key (falls back to AWS_ACCESS_KEY_ID)
S3_SECRET_ACCESS_KEY=          # S3 secret key (falls back to AWS_SECRET_ACCESS_KEY)
S3_SESSION_TOKEN=              # S3 session token (falls back to AWS_SESSION_TOKEN)
S3_FORCE_PATH_STYLE=           # Set "1" or "true" for path-style addressing (MinIO, etc.)
S3_CORS_EXTRA_ORIGINS=         # Comma-separated extra origins for S3 CORS config
STORAGE_UPLOAD_SIGNING_KEY=    # Key for signing direct client-to-S3 upload tokens
STORAGE_CLIENT_UPLOAD=         # Enable client-side S3 uploads: "s3" | "presigned". Off if unset.
STORAGE_DEBUG=                 # Enable storage debug logging: "1" | "true"
AWS_ACCESS_KEY_ID=             # Fallback S3 access key
AWS_SECRET_ACCESS_KEY=         # Fallback S3 secret key
AWS_SESSION_TOKEN=             # Fallback S3 session token

# ── IP Geolocation ──────────────────────────────────────────────────────────
IP_GEOLOCATION_DISABLED=       # Set "1" or "true" to disable IP geolocation lookups
IP_GEOLOCATION_URL_TEMPLATE=   # Custom IP geolocation API URL template

# ── Headless Rendering (Internet Explorer live-browser previews) ────────────
HEADLESS_RENDER_URL_TEMPLATE=  # URL template for headless browser rendering service
HEADLESS_BROWSER_WS_ENDPOINT=  # Direct WebSocket endpoint to a headless browser (alternative above)
HEADLESS_RENDER_AUTH_HEADER=   # Auth header name for the headless rendering service
HEADLESS_RENDER_AUTH_TOKEN=    # Auth token value for the headless rendering service

# ── Internet Explorer: Live Browser ────────────────────────────────────────
IE_LIVE_BROWSER=               # Enable live browser mode: "1" | "true"
IE_LIVE_VIEW_URL_TEMPLATE=     # URL template for the live browser view service
IE_PROXY_SESSIONS=             # Enable IE proxy sessions: "1" | "true"

# ── Internet Relay Chat (IRC) Bridge ────────────────────────────────────────
IRC_BRIDGE_DISABLED=           # Set "1" to disable the IRC bridge

# ── Telegram Bot (legacy — most routes deleted) ─────────────────────────────
TELEGRAM_BOT_TOKEN=            # Telegram bot token (only used by recovery-channels code)
TELEGRAM_WEBHOOK_URL=          # Telegram webhook URL
TELEGRAM_WEBHOOK_SECRET=       # Telegram webhook secret token

# ── YouTube API ─────────────────────────────────────────────────────────────
# YouTube API keys are consumed from process.env alphabetically; any var
# matching YOUTUBE_* or containing API is scanned.
YOUTUBE_API_KEY=               # YouTube Data API key

# ── Misc ────────────────────────────────────────────────────────────────────
INFINITE_PC_BASE=              # Base URL for Infinite PC app
RYOS_ELECTRON_URL=             # Override URL for Electron desktop app
ELECTRON_PUBLISH=              # Set "always" to publish Electron builds
GIT_COMMIT_SHA=                # Injected at build time
SOURCE_COMMIT=                 # Injected at build time
VITE_PORT=                     # Vite dev server port (default 5173)